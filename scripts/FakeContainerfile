FROM docker.io/library/golang:1.27.3-alpine3.23@sha256:8a5046497cda39860b832ffdbe8dd66018a0f05bb01352f533a36e7e2ced66a0 AS build
WORKDIR /src
ENV GOTOOLCHAIN=local CGO_ENABLED=0
COPY go.mod go.sum ./
COPY cmd/fake-sonarr ./cmd/fake-sonarr
RUN go build -trimpath -buildvcs=false -o /fake-sonarr ./cmd/fake-sonarr
FROM scratch
COPY --from=build /fake-sonarr /fake-sonarr
USER 65532:65532
ENTRYPOINT ["/fake-sonarr"]
