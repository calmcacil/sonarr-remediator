{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["mise"],
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "The govulncheck executable is versioned by its parent Go module",
      "matchManagers": ["mise"],
      "matchDepNames": ["go:golang.org/x/vuln/cmd/govulncheck"],
      "overridePackageName": "golang.org/x/vuln"
    },
    {
      "matchManagers": ["mise"],
      "matchPackageNames": ["*"],
      "groupName": "mise tools"
    }
  ]
}
