{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "enabledManagers": ["mise", "gomod", "dockerfile", "github-actions"],
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "dockerfile": {
    "managerFilePatterns": ["/(^|/)[^/]*Containerfile$/"]
  },
  "packageRules": [
    {
      "description": "The govulncheck executable is versioned by its parent Go module",
      "matchManagers": ["mise"],
      "matchDepNames": ["go:golang.org/x/vuln/cmd/govulncheck"],
      "overridePackageName": "golang.org/x/vuln"
    },
    {
      "description": "Update the local, CI, module, and container Go toolchain together",
      "matchPackageNames": ["go", "golang", "golang/go", "docker.io/library/golang"],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain"
    },
    {
      "matchManagers": ["mise"],
      "matchPackageNames": ["!go", "!golang/go"],
      "groupName": "mise tools"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": true,
      "rangeStrategy": "bump"
    }
  ]
}
